APP_NAME=CyraAgroLink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cyra_agrolink_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@cyraagrolink.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Paystack (required for real wallet deposits in production)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_MERCHANT_EMAIL=

# Demo catalog auto-seeding on HTTP requests (null = allowed outside production only)
CYRA_ALLOW_DEMO_SEEDING=

# Outbound SMS: log (default) or termii
MESSAGING_SMS_DRIVER=log
TERMII_API_KEY=
TERMII_SENDER_ID=CyraAgro
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=generic

# CyraAI: "local" works offline. Set provider=openai + API key for open-ended LLM answers.
CYRA_AI_PROVIDER=local
CYRA_AI_API_KEY=
CYRA_AI_BASE_URL=https://api.openai.com/v1
CYRA_AI_MODEL=gpt-4o-mini
CYRA_AI_TIMEOUT=35
CYRA_AI_MAX_TOKENS=700

CYRA_APP_NAME=CyraAgroLink
CYRA_BRAND=CyraAgroLink
CYRA_COMPANY="CYRA-TECH LTD"
CYRA_API_VERSION=v1
CYRA_API_PREFIX=api/v1
CYRA_DEFAULT_PER_PAGE=15
CYRA_MAX_PER_PAGE=100
CYRA_DEFAULT_ROLE=farmer

# ---------------------------------------------------------------------------
# Production checklist (copy into .env on the server — do NOT use local values)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example
# LOG_LEVEL=warning
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# MAIL_MAILER=smtp
# PAYSTACK_PUBLIC_KEY=pk_live_...
# PAYSTACK_SECRET_KEY=sk_live_...
# CYRA_ALLOW_DEMO_SEEDING=false
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# TERMII_API_KEY=...
# MESSAGING_SMS_DRIVER=termii
